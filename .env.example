# =============================================================================
# .env.example — copiar a .env y completar con valores reales.
# NUNCA commitear el archivo .env real al repositorio.
# =============================================================================

# --- Entorno ---
NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL) ---
# Usadas por el contenedor "db" en docker-compose.prod.yml para inicializar
# el usuario/base de PostgreSQL la primera vez que se crea el volumen.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=app_db

# Usada por el backend para conectarse. El host DEBE ser "db" (el nombre
# del servicio en docker-compose), y usuario/password/base DEBEN coincidir
# exactamente con los tres valores POSTGRES_* de arriba.
# Formato: postgres://usuario:password@host:puerto/base
DATABASE_URL=postgres://app_user:changeme_use_a_strong_password@db:5432/app_db

# --- Sesiones ---
# Cadena aleatoria larga (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=changeme_generate_a_long_random_string

# Nombre de la cookie de sesión
SESSION_COOKIE_NAME=sid

# Duración de la sesión en milisegundos (8 horas por defecto)
SESSION_MAX_AGE_MS=28800000

# --- CORS ---
# Origen exacto permitido para llamadas al API (sin barra final)
CORS_ORIGIN=http://localhost:8080

# --- Logging ---
# uno de: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# --- Rate limiting (login) ---
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# --- Bloqueo de cuenta ---
ACCOUNT_LOCK_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MS=900000

# --- Integración Microsoft 365 (sincronización de licencias) ---
# Clave hex de 64 caracteres (32 bytes) para cifrar en reposo el client
# secret de la app registrada en Azure AD (AES-256-GCM). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se cambia esta clave después de guardar una configuración, hay que
# volver a cargar el client secret desde la pantalla de Configuración.
M365_ENCRYPTION_KEY=changeme_generate_a_64_char_hex_key

# --- Usuario administrador inicial (solo usado por `npm run seed:run`) ---
# Sin valores por defecto a propósito: no debe existir un admin/admin de
# fábrica. Definir antes de correr los seeds por primera vez.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
